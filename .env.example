META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Razorpay — dormant until Month 7
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cron protection (Vercel cron secret)
CRON_SECRET=
